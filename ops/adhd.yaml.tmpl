# Generated by ops/install.sh from ops/adhd.yaml.tmpl — do not edit.
#
# A dedicated adhd instance for the skillz collection. Its MCP server is bound
# to loopback: adhd has no inbound auth, so a wider bind would be an
# unauthenticated public surface. The dashboard light comes from the smoke-alarm
# instance started by ops/install.sh, which watches the skillz MCP surface.
mcp_server:
  enabled: true
  addr: "127.0.0.1:@ADHD_PORT@"

smoke_alarm:
  - name: "skillz"
    endpoint: "http://127.0.0.1:@ALARM_PORT@"
    interval: 10s
    use_sse: false

features:
  search_paths: []
