# Generated by ops/install.sh from ops/smoke-alarm.yaml.tmpl — do not edit.
version: "1"

service:
  name: "skillz-alarm"
  environment: "lab"
  mode: "foreground"
  log_level: "info"
  poll_interval: "10s"
  timeout: "5s"
  max_workers: 4

health:
  enabled: true
  listen_addr: "127.0.0.1:@ALARM_PORT@"
  endpoints:
    healthz: "/healthz"
    readyz: "/readyz"
    status: "/status"

runtime:
  lock_file: "@ALARM_STATE@/skillz-alarm.lock"
  state_dir: "@ALARM_STATE@"
  baseline_file: "@ALARM_STATE@/known-good.json"
  event_history_size: 400
  graceful_shutdown_timeout: "5s"

discovery:
  enabled: false

alerts:
  aggressive: false
  notify_on_regression_immediately: true
  severity:
    healthy: "info"
    degraded: "warn"
    regression: "error"
    outage: "critical"
  sinks:
    log:
      enabled: true
    os_notification:
      enabled: false

targets:
  - id: "skillz-mcp"
    enabled: true
    protocol: "mcp"
    name: "skillz MCP (read-only canon)"
    endpoint: "http://127.0.0.1:@MCP_PORT@/mcp"
    transport: "http"
    expected:
      healthy_status_codes: [200]
      min_capabilities:
        - "skills/read"
    auth:
      type: "none"
    check:
      interval: "5s"
      timeout: "2s"
      retries: 1
      handshake_profile: "base"
      required_methods:
        - "initialize"
        - "skills/status"

  - id: "skillz-sync"
    enabled: true
    protocol: "mcp"
    name: "skillz upstream sync (pinned sources)"
    endpoint: "http://127.0.0.1:@MCP_PORT@/mcp"
    transport: "http"
    expected:
      healthy_status_codes: [200]
      min_capabilities:
        - "sync/current"
    auth:
      type: "none"
    check:
      interval: "15s"
      timeout: "10s"
      retries: 1
      handshake_profile: "base"
      required_methods:
        - "initialize"
        - "sync/status"

  - id: "wan-ingress"
    enabled: @INGRESS_ENABLED@
    protocol: "mcp"
    name: "WAN ingress (signed border front)"
    endpoint: "http://127.0.0.1:@INGRESS_PORT@/mcp"
    transport: "http"
    expected:
      healthy_status_codes: [200]
      min_capabilities:
        - "ingress/forward"
    auth:
      type: "none"
    check:
      interval: "5s"
      timeout: "2s"
      retries: 1
      handshake_profile: "base"
      required_methods:
        - "initialize"
        - "ingress/status"

known_state:
  enabled: true
  persist: true
  sustain_success_before_mark_healthy: 1
  classify_new_failures_after_healthy_as: "regression"
  outage_threshold_consecutive_failures: 2

meta_config:
  enabled: false

hosted:
  enabled: false

federation:
  enabled: true
  base_port: 6140
  max_port: 6150
  poll_interval: "5s"
  announce_interval: "10s"
  heartbeat_interval: "10s"
  heartbeat_timeout: "30s"
